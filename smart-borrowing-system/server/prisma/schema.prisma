generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("BORROWER")
  borrowings   Borrowing[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Category {
  id        String      @id @default(cuid())
  name      String      @unique
  equipment Equipment[]
}

model Equipment {
  id                String        @id @default(cuid())
  name              String
  description       String?
  assetTag          String        @unique
  qrCode            String?       @unique
  totalQuantity     Int           @default(1)
  availableQuantity Int           @default(1)
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  borrowingItems    BorrowingItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Borrowing {
  id          String          @id @default(cuid())
  borrowerId  String
  borrower    User            @relation(fields: [borrowerId], references: [id])
  status      String          @default("PENDING")
  requestedAt DateTime        @default(now())
  dueAt       DateTime
  checkedOutAt DateTime?
  returnedAt  DateTime?
  notes       String?
  items       BorrowingItem[]
  updatedAt   DateTime        @updatedAt
}

model BorrowingItem {
  id          String    @id @default(cuid())
  borrowingId String
  borrowing   Borrowing @relation(fields: [borrowingId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  quantity    Int       @default(1)

  @@unique([borrowingId, equipmentId])
}

